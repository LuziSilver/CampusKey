<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/back_button"
            android:textSize="14sp"
            android:backgroundTint="#1F4E79"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Real title (with the school name) is set in ListingsActivity.kt;
             this default is only a placeholder shown in the layout preview. -->
        <TextView
            android:id="@+id/listingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/listings_default_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F4E79"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/listings_instructions"
            android:textSize="13sp"
            android:textColor="#595959" />

    </LinearLayout>

    <!-- Scrollable list: fills all the remaining height -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp" />

    </ScrollView>

</LinearLayout>
